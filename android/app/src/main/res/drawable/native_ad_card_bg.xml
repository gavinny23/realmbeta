<?xml version="1.0" encoding="utf-8"?>
<!-- Matches RMColors.surface (#13131A) / RMColors.border (#2A2A3A) /
     18dp corner radius used by NewsCard and DropCard in Dart, so the
     native ad card sits in the feed without looking like a foreign
     element. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#13131A"/>
    <corners android:radius="18dp"/>
    <stroke android:width="1dp" android:color="#2A2A3A"/>
</shape>
