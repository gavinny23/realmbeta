<?xml version="1.0" encoding="utf-8"?>
<!--
  Native Advanced ad card, built to sit visually alongside NewsCard /
  DropCard in the Updates and Drops feeds: same surface color, border,
  and 18dp corner radius (see native_ad_card_bg.xml), same rough
  content rhythm (media image up top, headline, body, a pill row at
  the bottom).

  Image-only for now, per the "image ads first, video later in Flicks"
  plan: mediaView is used for the ad's main image asset. Google's SDK
  decides at runtime whether a given native ad is image or video —
  NativeAdFactoryImpl below simply doesn't wire up anything that would
  need to distinguish them, since AdMob's native-advanced test ad unit
  only ever returns image creatives.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/native_ad_card_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- "Ad" badge + advertiser name, same slot NewsCard uses for
             its source + tier badge row. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/native_ad_badge_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Ad"
                android:textColor="#FFB830"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/ad_advertiser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="#8888A8"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Main image creative. Fixed aspect ratio via height so the
             card doesn't jump around as different creatives load,
             matching the fixed-ish image slot NewsCard/DropCard use. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginBottom="10dp"
            android:background="#1C1C27">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F0F0F8"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8888A8"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="12dp"/>

        <!-- Bottom row: star rating (when the creative has one) on the
             left, CTA button on the right — same footer rhythm as the
             "View full story" link row on NewsCard. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <RatingBar
                android:id="@+id/ad_stars"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.1"
                android:visibility="gone"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/ad_cta"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/native_ad_cta_bg"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textColor="#F0F0F8"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
